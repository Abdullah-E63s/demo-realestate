generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Property {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  type        String    // Residential Plot, Commercial Plot, File, House, Villa, Apartment, Farm House
  status      String    @default("Available") // Available, Sold, Reserved
  price       Float
  priceLabel  String    // Human readable: "PKR 1.85 Crore"
  size        Float
  sizeUnit    String    @default("Marla") // Marla or Kanal
  society     String    // DHA Lahore, Bahria Town Lahore, Gulberg, etc.
  phase       String?   // Phase 6, Phase 8, etc.
  location    String    // Full location string
  description String
  features    String    @default("[]") // JSON-encoded array of strings
  images      String    @default("[]") // JSON-encoded array of image URLs
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inquiries   Inquiry[]
}

model Agent {
  id       Int     @id @default(autoincrement())
  name     String
  role     String
  phone    String
  whatsapp String
  image    String?
  bio      String?
}

model Inquiry {
  id         Int       @id @default(autoincrement())
  name       String
  email      String
  phone      String
  message    String
  type       String    @default("general") // general, site-visit, whatsapp
  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  isRead     Boolean   @default(false)
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String // bcrypt hashed
  role     String @default("admin")
}
